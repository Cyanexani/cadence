{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cadence",
  "version": "0.0.1",
  "identifier": "app.cadence.player",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:5288"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cadence",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
